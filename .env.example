# MongoDB connection string
MONGODB_URI=your_mongodb_connection_string_here

# Server port
PORT=5000

# JWT secret key for authentication (use a random string in production)
JWT_SECRET=your_random_secret_key_here

# Frontend base URL used in password reset email links
FRONTEND_URL=http://localhost:5173

# SMTP configuration for forgot-password emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here
SMTP_FROM=Varnam Silks <your_email@gmail.com>

# Razorpay Configuration (Get from https://dashboard.razorpay.com/)
# For testing, you can use test mode credentials (they start with rzp_test_)
RAZORPAY_KEY_ID=rzp_test_1DP5mmOlF5G5ag
RAZORPAY_KEY_SECRET=thisissecretkey
